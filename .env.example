# --- Obligatorias en produccion (docker-compose.prod.yml) ---
GITHUB_OWNER=tu_usuario_github
TAG=latest
# Token de administracion (/model/reload, /model/rollback): >= 16 caracteres aleatorios.
# Generar con: openssl rand -hex 32
CHURN_ADMIN_TOKEN=genera-un-token-seguro
# IP del VPS dentro de la VPN: Caddy solo escucha ahi (Docker publica puertos saltandose ufw)
VPN_BIND_IP=10.8.0.1

# --- Opcionales ---
# API key para /predict, /model/info, /model/versions y /monitoring/drift (cabecera X-API-Key)
# CHURN_API_KEY=
# Gate de calidad del reentrenamiento (AUC minimo para publicar un modelo)
# CHURN_MIN_ROC_AUC=0.75
# Campeon/retador: el modelo nuevo solo pasa a servicio si su AUC sobre los datos nuevos
# es >= AUC del modelo actual - margen (0 = al menos igual de bueno; 1 = promover siempre)
# CHURN_PROMOTION_MARGIN=0
# Datos ETIQUETADOS para reentrenar (ruta en el host a un .csv/.parquet con las features y
# la columna `churn`). Sin ella, retrain-if-drift.sh avisa y no reentrena: la API guarda
# features y probabilidades, no etiquetas, y el generador sintetico no corrige ningun drift.
# CHURN_TRAIN_DATA=/opt/mlops-churn-platform/data/churn_2026q3.parquet
# Versiones de modelo que se conservan en el volumen
# CHURN_MODEL_KEEP_VERSIONS=5
# Aviso (JSON {"text": ...}) que envia retrain-if-drift.sh, p. ej. un webhook de Slack
# WEBHOOK_URL=
# Registro de imagenes y puertos de Caddy: solo para ensayar el stack de produccion en local
# IMAGE_REGISTRY=localhost:5001
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
