# --- Obligatorias en produccion (docker-compose.prod.yml) ---
GITHUB_OWNER=tu_usuario_github
TAG=latest
# Token de administracion (/model/reload, /model/rollback): >= 16 caracteres aleatorios.
# Generar con: openssl rand -hex 32
CHURN_ADMIN_TOKEN=genera-un-token-seguro
# IP del VPS dentro de la VPN: Caddy solo escucha ahi (Docker publica puertos saltandose ufw)
VPN_BIND_IP=10.8.0.1

# --- Opcionales ---
# API key para /predict, /model/info, /model/versions y /monitoring/* (cabecera X-API-Key)
# CHURN_API_KEY=
# Token propio de POST /labels (cabecera X-Labels-Token) para el job del CRM que devuelve el
# churn real: asi no necesita el token de administracion. Sin el, /labels exige
# X-Admin-Token. >= 16 caracteres aleatorios y distinto de CHURN_ADMIN_TOKEN.
# CHURN_LABELS_TOKEN=
# Gate de calidad del reentrenamiento (AUC minimo para publicar un modelo)
# CHURN_MIN_ROC_AUC=0.75
# Campeon/retador: el modelo nuevo solo pasa a servicio si su AUC sobre los datos nuevos
# es >= AUC del modelo actual - margen (0 = al menos igual de bueno; 1 = promover siempre)
# CHURN_PROMOTION_MARGIN=0
# Datos ETIQUETADOS para reentrenar. Por defecto retrain-if-drift.sh construye el dataset
# con las etiquetas recibidas por la API (POST /labels) si hay al menos
# CHURN_LABELS_MIN_ROWS; CHURN_TRAIN_DATA (ruta en el host a un .csv/.parquet con las
# features y la columna `churn`) lo sustituye por un fichero propio (export del CRM).
# CHURN_TRAIN_DATA=/opt/mlops-churn-platform/data/churn_2026q3.parquet
# CHURN_LABELS_MIN_ROWS=500
# Predicciones que se conservan para poder etiquetarlas (la etiqueta llega semanas despues).
# Dimensionado: predicciones/dia x dias hasta la etiqueta x 1.5 (p. ej. 2000/dia x 60 dias
# x 1.5 = 180000; ~0.4 KB por prediccion en drift.sqlite). KEEP_DAYS acota ademas la
# antiguedad (0 = sin limite); las predicciones ya etiquetadas se conservan aparte.
# CHURN_PREDICTION_KEEP_ROWS=100000
# CHURN_PREDICTION_KEEP_DAYS=0
# Versiones de modelo que se conservan en el volumen
# CHURN_MODEL_KEEP_VERSIONS=5
# Aviso (JSON {"text": ...}) que envia retrain-if-drift.sh, p. ej. un webhook de Slack
# WEBHOOK_URL=
# Registro de imagenes y puertos de Caddy: solo para ensayar el stack de produccion en local
# IMAGE_REGISTRY=localhost:5001
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
